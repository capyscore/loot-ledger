<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loot Ledger" Width="264" Height="156" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        FontFamily="Segoe UI" UseLayoutRounding="True">
  <Border x:Name="Card" CornerRadius="15" BorderBrush="#5966543B" BorderThickness="1">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F7242028" Offset="0"/>
        <GradientStop Color="#F613151C" Offset="0.55"/>
        <GradientStop Color="#FA101116" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="54"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="29"/>
      </Grid.RowDefinitions>
      <Border Width="66" Height="2" Margin="15,0,0,0"
              HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="1">
        <Border.Background>
          <LinearGradientBrush>
            <GradientStop Color="#FFFFC875" Offset="0"/>
            <GradientStop Color="#12FFB557" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Grid Margin="12,9,12,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="38"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border CornerRadius="10" Background="#26F3B95F" BorderBrush="#4CF3B95F" BorderThickness="1">
          <Viewbox Width="24" Height="24">
            <Canvas Width="28" Height="28">
              <Path Stroke="#FFD18B" StrokeThickness="1.55" StrokeLineJoin="Round"
                    Data="M 3,13 C 3,9 6,6 10,6 L 18,6 C 22,6 25,9 25,13 L 25,21 Q 25,22 24,22 L 4,22 Q 3,22 3,21 Z M 3,14 L 11,14 M 17,14 L 25,14 M 7,14 L 7,21 M 21,14 L 21,21"/>
              <Rectangle Canvas.Left="11.5" Canvas.Top="12" Width="5" Height="6"
                         RadiusX="1" RadiusY="1" Fill="#FFD18B"/>
              <Path Stroke="#FFD18B" StrokeThickness="1.25" StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" Data="M 23,2 L 23,5 M 21.5,3.5 L 24.5,3.5"/>
            </Canvas>
          </Viewbox>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
          <TextBlock Text="LOOT LEDGER" Foreground="#FFF6E8" FontSize="16"
                     FontFamily="Bahnschrift, Segoe UI" FontWeight="SemiBold"/>
          <TextBlock Text="FORTNITE CHEST TRACKER" Foreground="#C9C3CC"
                     FontSize="8.5" FontWeight="SemiBold" Margin="0,2,0,0"/>
        </StackPanel>
        <Border Grid.Column="2" CornerRadius="5" BorderThickness="1" BorderBrush="#53EDB86A"
                Background="#19EDB86A" Padding="5,2" VerticalAlignment="Center">
          <TextBlock x:Name="Mode" Text="AUTO" Foreground="#FFCF87" FontWeight="Bold" FontSize="9"/>
        </Border>
      </Grid>
      <Grid Grid.Row="1" Margin="12,0,12,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="7"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border CornerRadius="8" BorderThickness="1" BorderBrush="#4AD79E56" Background="#2AB78032">
          <StackPanel Margin="9,3,8,3" VerticalAlignment="Center">
            <TextBlock x:Name="MatchLabel" Text="THIS MATCH" Foreground="#FFE1AF" FontWeight="SemiBold" FontSize="9"/>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="32" HorizontalAlignment="Left">
              <TextBlock x:Name="MatchCount" Text="0" Foreground="#FFCF7D" FontFamily="Bahnschrift, Segoe UI"
                         FontWeight="SemiBold" FontSize="33" LineHeight="33" LineStackingStrategy="BlockLineHeight"/>
            </Viewbox>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" CornerRadius="8" BorderThickness="1" BorderBrush="#2BE1DBEC" Background="#1EAAA6B8">
          <StackPanel Margin="9,3,8,3" VerticalAlignment="Center">
            <TextBlock Text="ALL-TIME TOTAL" Foreground="#D9D3DE" FontWeight="SemiBold" FontSize="9"/>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="32" HorizontalAlignment="Left">
              <TextBlock x:Name="TotalCount" Text="0" Foreground="#FFF8F1" FontFamily="Bahnschrift, Segoe UI"
                         FontWeight="SemiBold" FontSize="33" LineHeight="33" LineStackingStrategy="BlockLineHeight"/>
            </Viewbox>
          </StackPanel>
        </Border>
      </Grid>
      <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#24E1DBEC" Margin="12,0">
        <Grid Margin="2,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#9B96A6"/>
            <TextBlock x:Name="StatusText" Text="Waiting for Fortnite" Foreground="#E6E0EA"
                       FontSize="10" Margin="6,0,0,0"/>
          </StackPanel>
          <TextBlock x:Name="EventText" Text="" FontWeight="SemiBold" Foreground="#FFD18B"
                     HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
